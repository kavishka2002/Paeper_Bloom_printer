{
  "name": "bloomconnect",
  "productName": "BloomConnect",
  "version": "0.4.9",
  "description": "WhatsApp Automation & Print Management",
  "author": "BloomConnect",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "npm run build && node scripts/launch.cjs",
    "build": "tsc --noEmit && vite build && node scripts/build.cjs",
    "test": "node --test tests/*.test.cjs",
    "installer": "npm run build && node scripts/installer.cjs"
  },
  "dependencies": {
    "@types/qrcode": "1.5.6",
    "drizzle-orm": "^0.45.0",
    "electron-updater": "6.8.11",
    "fflate": "0.8.3",
    "pdf-lib": "1.17.1",
    "puppeteer-core": "24.38.0",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "whatsapp-web.js": "1.34.8"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/noto-sans-sinhala": "^5.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@xyflow/react": "^12.0.0",
    "electron": "42.11.18",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.468.0",
    "motion": "^14.14.0",
    "pdfjs-dist": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "build": {
    "appId": "lk.bloomconnect.desktop",
    "productName": "BloomConnect",
    "artifactName": "BloomConnect-Setup-${version}.${ext}",
    "publish": {
      "provider": "generic",
      "url": "https://github.com/kavishka2002/Paeper_Bloom_printer/releases/latest/download/"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "win": {
      "target": "nsis",
      "signExecutable": false,
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
